{
  "extends": ["stylelint-config-standard"],
  "plugins": ["stylelint-prettier"],
  "rules": {
    "prettier/prettier": true,
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "apply",
          "layer",
          "responsive",
          "screen",
          "tailwind",
          "variants",
          "config",
          "source",
          "theme",
          "plugin",
          "utility",
          "variant",
          "custom-variant"
        ]
      }
    ],
    "no-descending-specificity": null,
    "import-notation": "string"
  }
}
